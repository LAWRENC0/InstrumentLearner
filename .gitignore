# Dependencies
node_modules/

# Production builds
dist/

# Local environment files
.env
.env.*
!.env.example

# Logs and debug output
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# IDE and editor files
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/

# Operating-system files
.DS_Store
Thumbs.db
desktop.ini

# Temporary files
*.tmp
*.temp
*.swp

# ideas.txt
# Downloaded source PDFs for the knowledge base (large, kept out of git).
# The catalogue of what is here, with licences and links, is knowledge/sources/SOURCES.md.
knowledge/sources/**/*.pdf
# Plain-text extractions of the source PDFs (regenerated from the PDFs).
knowledge/sources/_text/
